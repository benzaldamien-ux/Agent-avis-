# --- Google Business Profile (OAuth2, type "Application de bureau") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtenu une seule fois via `npm run get-token`
GOOGLE_REFRESH_TOKEN=
# Trouvés via `npm run accounts`
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=

# --- Gemini (Google AI Studio, clé gratuite sur https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Profil de l'entreprise (utilisé pour générer les réponses) ---
BUSINESS_NAME="Nom de mon entreprise"
BUSINESS_TONE="professionnel, chaleureux et concis"
BUSINESS_LANGUAGE="français"
BUSINESS_SIGNATURE="L'équipe de Nom de mon entreprise"

# --- Stockage local des avis et brouillons ---
DATA_FILE=data/reviews.json
